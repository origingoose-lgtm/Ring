  questions:
  - type: 0
    questionText: "\u0414\u043B\u044F \u0447\u0435\u0433\u043E \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0443
      \u043D\u0443\u0436\u043D\u043E \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
      \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0434\u0430\u043D\u043D\u044B\u0445?"
    explanation: "\u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435: \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430
      \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442
      \u0434\u0430\u043D\u043D\u044B\u0435, \u0432 \u0442\u043E\u043C \u0447\u0438\u0441\u043B\u0435
      \u043A\u043E\u0433\u0434\u0430 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440
      \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D."
    answers:
    - "A. \u0427\u0442\u043E\u0431\u044B \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C
      \u0444\u0430\u0439\u043B\u044B \u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u044B"
    - "B. \u0427\u0442\u043E\u0431\u044B \u043E\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C
      \u044D\u043A\u0440\u0430\u043D"
    - "C. \u0427\u0442\u043E\u0431\u044B \u043E\u0445\u043B\u0430\u0436\u0434\u0430\u0442\u044C
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443"
    - "D. \u0427\u0442\u043E\u0431\u044B \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0442\u044C
      \u0437\u0432\u0443\u043A"
    correctAnswer: 0
    matchingLeft: []
    matchingRight: []
    correctMatchForLeft: 
    orderItems: []
    correctOrder: 
  - type: 0
    questionText: "\u041A\u0430\u043A\u043E\u0439 \u0438\u0437 \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u0445
      \u043D\u043E\u0441\u0438\u0442\u0435\u043B\u0435\u0439 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442
      \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u044B\u0439 \u0434\u0438\u0441\u043A
      \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u043E\u0440\u043F\u0443\u0441\u0430?"
    explanation: "\u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435: \u0434\u0438\u0441\u043A\u0435\u0442\u0430
      \u0445\u0440\u0430\u043D\u0438\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043D\u0430 \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u043C \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0435.
      \u0415\u0451 \u043D\u0443\u0436\u043D\u043E \u0447\u0438\u0442\u0430\u0442\u044C
      \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0434\u0438\u0441\u043A\u043E\u0432\u043E\u0434\u0430."
    answers:
    - "A. \u0411\u0443\u043C\u0430\u0436\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0430"
    - "B. \u0413\u0438\u0431\u043A\u0438\u0439 \u0434\u0438\u0441\u043A\u0435\u0442\u0430
      (\u0434\u0438\u0441\u043A\u0435\u0442\u0430)"
    - "C. \u0421\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u0430\u044F \u043B\u0438\u043D\u0437\u0430"
    - "D. \u041A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430"
    correctAnswer: 1
    matchingLeft: []
    matchingRight: []
    correctMatchForLeft: 
    orderItems: []
    correctOrder: 
  - type: 0
    questionText: "\u0427\u0442\u043E \u0442\u0430\u043A\u043E\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440?"
    explanation: "\u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435: \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C \u0438 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0442
      \u0432 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0434\u0430\u043D\u043D\u044B\u0445."
    answers:
    - "A. \u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u043A\u043E\u043C\u0430\u043D\u0434\u044B
      \u0438 \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0434\u0430\u043D\u043D\u044B\u0435"
    - "B. \u0412\u0438\u0434 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u043D\u043E\u0433\u043E
      \u0434\u0438\u0441\u043A\u0430"
    - "C. \u041A\u0430\u0431\u0435\u043B\u044C \u0434\u043B\u044F \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u043C\u043E\u043D\u0438\u0442\u043E\u0440\u0430"
    - "D. \u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E \u0434\u043B\u044F
      \u043F\u0435\u0447\u0430\u0442\u0438 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435"
    correctAnswer: 0
    matchingLeft: []
    matchingRight: []
    correctMatchForLeft: 
    orderItems: []
    correctOrder: 
  - type: 0
    questionText: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0441\u0442\u0430\u0440\u044B\u0435
      \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u044B \u043C\u043E\u0433\u0443\u0442
      \u0438\u043C\u0435\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0430\u043C\u044F\u0442\u0438,
      \u0447\u0435\u043C \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435?"
    explanation: "\u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435: \u0441\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043D\u043D\u044B\u0435 \u043A\u043E\u043C\u043F\u043E\u043D\u0435\u043D\u0442\u044B
      \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u044B \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
      \u0434\u0430\u043D\u043D\u044B\u0445."
    answers:
    - "A. \u0423 \u043D\u0438\u0445 \u043D\u0435 \u0431\u044B\u043B\u043E \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C"
    - "B. \u0421\u0442\u0430\u0440\u044B\u0435 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u044B
      \u043D\u0435 \u043C\u043E\u0433\u043B\u0438 \u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u0447\u0438\u0441\u043B\u0430"
    - "C. \u0412\u0441\u0435 \u0441\u0442\u0430\u0440\u044B\u0435 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u044B
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u0431\u0435\u0437 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u0430"
    - "D. \u0422\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u043B\u0438\u0441\u044C"
    correctAnswer: 3
    matchingLeft: []
    matchingRight: []
    correctMatchForLeft: 
    orderItems: []
    correctOrder: 
  - type: 0
    questionText: "\u0427\u0442\u043E \u043D\u0443\u0436\u043D\u043E \u0441\u0434\u0435\u043B\u0430\u0442\u044C,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u0434\u0430\u043D\u043D\u044B\u0435 \u0441 \u0434\u0438\u0441\u043A\u0435\u0442\u044B
      \u043D\u0430 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0435 \u0431\u0435\u0437
      \u0434\u0438\u0441\u043A\u043E\u0432\u043E\u0434\u0430?"
    explanation: "\u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435: \u043D\u0443\u0436\u0435\u043D
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0439 \u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0442\u0435\u043B\u044C
      \u0438, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439
      \u0430\u0434\u0430\u043F\u0442\u0435\u0440 \u0438\u043B\u0438 \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u043D\u043E\u0435
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D\u0438\u0435."
    answers:
    - "A. \u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u0438\u043C\u044B\u0439 \u0432\u043D\u0435\u0448\u043D\u0438\u0439
      \u0434\u0438\u0441\u043A\u043E\u0432\u043E\u0434 \u0438\u043B\u0438 \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      \u0447\u0442\u0435\u043D\u0438\u044F"
    - "B. \u041F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u043A \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440\u0443
      \u043E\u0431\u044B\u0447\u043D\u0443\u044E \u043C\u044B\u0448\u044C"
    - "C. \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0434\u0438\u0441\u043A\u0435\u0442\u0443
      \u043D\u0430 \u043A\u043B\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0443"
    - "D. \u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C \u044F\u0440\u043A\u043E\u0441\u0442\u044C
